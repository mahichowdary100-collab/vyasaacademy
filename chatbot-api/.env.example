# Vyasa Guru backend - environment template
# Copy to .env (the .env file must NEVER be committed) and fill in.

# Secret provider key. When left empty the API answers from the
# built-in verified knowledge base only (no external AI calls).
AI_API_KEY=

# Provider type: "openai" (chat completions, default) or "openai-responses"
AI_PROVIDER=openai

# Model id, e.g. gpt-4o-mini
AI_MODEL=gpt-4o-mini

# OpenAI-compatible base URL
AI_BASE_URL=https://api.openai.com

# Request timeout in milliseconds
AI_TIMEOUT_MS=15000

# Local server port (server.js only)
PORT=3000